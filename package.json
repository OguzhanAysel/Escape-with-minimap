{
  "name": "tarkov-overlay",
  "version": "1.0.0",
  "description": "Escape from Tarkov Yardımcı Harita ve Görev Overlay Uygulaması (Statik Veri & Yerel Dosyalar)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "fuse.js": "^7.0.0",
    "leaflet": "^1.9.4",
    "tesseract.js": "^5.1.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.tarkovhelper.overlay",
    "productName": "TarkovMapOverlay",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "TarkovMapOverlay-${version}-portable.exe"
    }
  }
}
