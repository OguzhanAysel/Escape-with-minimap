{
  "name": "tarkov-overlay",
  "version": "1.0.0",
  "description": "Escape from Tarkov Yardımcı Harita ve Görev Overlay Uygulaması (Statik Veri & Yerel Dosyalar)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/optimize-task-images.js",
    "build": "electron-builder --win portable",
    "optimize-images": "node scripts/optimize-task-images.js"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "fuse.js": "^7.0.0",
    "leaflet": "^1.9.4",
    "tesseract.js": "^5.1.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.tarkovhelper.overlay",
    "productName": "TarkovMapOverlay",
    "asar": false,
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "assets/**/*",
      "renderer/**/*",
      "src/**/*",
      "node_modules/**/*",
      "!assets/task-locations/*.png",
      "!assets/task-locations/*.PNG",
      "!assets/task-locations/*.jpg",
      "!assets/task-locations/*.jpeg",
      "!assets/task-locations/*.JPG",
      "!assets/task-locations/*.backup-*.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "TarkovMapOverlay-${version}-portable.exe"
    }
  }
}
